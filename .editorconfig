# Hirepath — one style, every editor. dotnet format + Prettier/ESLint enforce it.
root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
end_of_line = lf
indent_style = space
indent_size = 4

[*.{ps1,cmd,bat}]
end_of_line = crlf

[*.{json,yml,yaml,md,ts,js,html,scss,css}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# EF Core-generated migrations are machine-written; don't hold them to our
# hand-written style/analyzer rules (they still compile and are reviewed on add).
[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
dotnet_diagnostic.IDE0161.severity = none
dotnet_diagnostic.CA1861.severity = none

# ---------------------------------------------------------------------------
# C# style (mirrors "boring and readable" — standard .NET conventions)
# ---------------------------------------------------------------------------
[*.cs]
indent_size = 4

# this. preferences
dotnet_style_qualification_for_field = false:warning
dotnet_style_qualification_for_property = false:warning
dotnet_style_qualification_for_method = false:warning
dotnet_style_qualification_for_event = false:warning

# Language keywords vs framework types
dotnet_style_predefined_type_for_locals_parameters_members = true:warning
dotnet_style_predefined_type_for_member_access = true:warning

# var preferences — prefer explicit clarity where the type isn't obvious
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# Modern C# features
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
csharp_style_prefer_pattern_matching = true:suggestion
csharp_style_prefer_switch_expression = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning

# using directives
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true

# CA1707: underscored test method names (Given_When_Then) are the .NET testing
# convention and read far better than PascalCase for specs. Handled per-folder
# below, but declared here too for editors that don't match the tests glob.

# CA1716: "Resume" collides with a VB reserved word. Resume is core domain
# vocabulary and this app is never consumed from VB — the rule adds no value here.
dotnet_diagnostic.CA1716.severity = none

# CA1515: public types in the API assembly are intentionally public (it is the
# composition root and test entry point), not an inadvertently-exposed internal.
dotnet_diagnostic.CA1515.severity = none

# Naming: interfaces start with I, async methods end with Async, etc. (defaults)
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.severity = warning
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.symbols = interface_symbols
dotnet_naming_rule.interfaces_should_be_prefixed_with_i.style = i_prefix_style
dotnet_naming_symbols.interface_symbols.applicable_kinds = interface
dotnet_naming_style.i_prefix_style.required_prefix = I
dotnet_naming_style.i_prefix_style.capitalization = pascal_case

# Test projects: allow underscored test names and relax a few rules that fight
# idiomatic test code.
[tests/**/*.cs]
dotnet_diagnostic.CA1707.severity = none
dotnet_diagnostic.CA1515.severity = none
