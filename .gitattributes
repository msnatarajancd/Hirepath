# Normalize all text files to LF in the repo; check out per-platform.
* text=auto eol=lf

# Windows-only scripts must stay CRLF so they run correctly on Windows.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Explicit text types (avoid accidental binary detection)
*.cs      text eol=lf
*.csproj  text eol=lf
*.sln     text eol=crlf
*.props   text eol=lf
*.targets text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.ts      text eol=lf
*.html    text eol=lf
*.scss    text eol=lf
*.css     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf

# Binary assets — never touch line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.docx binary
*.db binary
