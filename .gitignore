# Build output
bin/
obj/
dist/
.angular/
out/

# Node / Angular
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE / editor state
*.user
*.suo
.vs/
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json

# Test / e2e artifacts
TestResults/
playwright-report/
playwright/.cache/
test-results/
coverage/

# Local database + app storage (never committed)
*.db
*.db-shm
*.db-wal
storage/

# Local config + secrets (never committed)
appsettings.Local.json
.env
.env.*
secrets.json

# Generated API client (regenerated by npm script)
src/Hirepath.Web/src/app/core/api/

# Build-time emitted OpenAPI document (source is the API, regenerated on build)
src/Hirepath.Api/Hirepath.Api.json

# Screenshots scratch
docs/screenshots/*.tmp

# OS cruft
.DS_Store
Thumbs.db
